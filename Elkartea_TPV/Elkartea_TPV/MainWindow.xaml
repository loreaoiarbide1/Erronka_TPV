<Window
    x:Class="Elkartea_TPV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Elkartea TPV"
    Width="850"
    Height="500"
    Background="#F2F2F2"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <StackPanel>

            <TextBlock
                Margin="0,10,0,10"
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#34495E"
                Text="ELKARTEA TPV" />

            <TextBlock
                x:Name="txtOngietorria"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                FontSize="18" />

            <!--  Administratzailearen aukerak  -->
            <StackPanel x:Name="panelAdministratzailea" Visibility="Collapsed">

                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Administratzailearen menua" />

                <Button
                    Height="45"
                    Margin="0,5"
                    Click="BtnErabiltzaileak_Click"
                    Content="Erabiltzaileak kudeatu" />

                <Button
                    Height="45"
                    Margin="0,5"
                    Click="BtnStocka_Click"
                    Content="Stocka/biltegia kudeatu" />

            </StackPanel>

            <!--  Erabiltzaile arruntaren aukerak  -->
            <StackPanel x:Name="panelErabiltzailea" Visibility="Collapsed">

                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Erabiltzailearen menua" />

                <Button
                    Height="45"
                    Margin="0,5"
                    Click="BtnKontsumoak_Click"
                    Content="Kontsumoak" />

                <Button
                    Height="45"
                    Margin="0,5"
                    Click="BtnErreserbak_Click"
                    Content="Erreserbak" />

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
