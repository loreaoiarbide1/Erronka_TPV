<Window
    x:Class="Elkartea_TPV.ErabiltzaileakWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kudeatu erabiltzaileak"
    Width="850"
    Height="600"
    Background="#F2F2F2"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            FontSize="25"
            FontWeight="Bold"
            Foreground="#34495E"
            Text="ERABILTZAILEEN KUDEAKETA" />

        <Border
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="15"
            Background="White"
            CornerRadius="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5">
                    <TextBlock Text="Erabiltzaile izena" />
                    <TextBox
                        x:Name="txtIzena"
                        Height="30"
                        Margin="0,5,10,10" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5">
                    <TextBlock Text="Pasahitza" />
                    <PasswordBox
                        x:Name="txtPasahitza"
                        Height="30"
                        Margin="0,5,0,10" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5">
                    <TextBlock Text="Erabiltzaile mota" />
                    <ComboBox
                        x:Name="cmbErabiltzaileMota"
                        Height="30"
                        Margin="0,5,10,0">
                        <ComboBoxItem Content="Erabiltzailea" />
                        <ComboBoxItem Content="Administratzailea" />
                    </ComboBox>
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="Aukeratu erabiltzaile bat zerrendan aldatzeko edo ezabatzeko."
                    TextWrapping="Wrap" />

            </Grid>
        </Border>

        <DataGrid
            x:Name="dgErabiltzaileak"
            Grid.Row="2"
            Margin="0,0,0,15"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            SelectionChanged="DgErabiltzaileak_SelectionChanged"
            SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Id}"
                    Header="ID" />

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ErabiltzaileIzena}"
                    Header="Erabiltzailea" />

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Mota}"
                    Header="Mota" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Width="110"
                Height="38"
                Margin="5"
                Click="BtnAtzera_Click"
                Content="Atzera" />

            <Button
                Width="110"
                Height="38"
                Margin="5"
                Click="BtnBerria_Click"
                Content="Berria" />

            <Button
                Width="110"
                Height="38"
                Margin="5"
                Background="#34495E"
                Click="BtnGorde_Click"
                Content="Gorde"
                Foreground="White" />

            <Button
                Width="110"
                Height="38"
                Margin="5"
                Background="#C0392B"
                Click="BtnEzabatu_Click"
                Content="Ezabatu"
                Foreground="White" />

        </StackPanel>
    </Grid>
</Window>
