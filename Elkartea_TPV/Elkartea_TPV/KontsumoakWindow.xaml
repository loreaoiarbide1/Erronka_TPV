<Window x:Class="Elkartea_TPV.KontsumoakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontsumoak"
        Height="720"
        Width="1150"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F2F3F5">

    <Window.Resources>

        <Style x:Key="KategoriaBotoia" TargetType="Button">
            <Setter Property="Background" Value="#263746"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="EkintzaBotoia" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Ezkerreko aldea: produktuak -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,12,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PRODUKTUAK"
                           FontSize="23"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <!-- Produktuen kategoriak -->
                <WrapPanel x:Name="panelKategoriak"
                           Grid.Row="1"
                           Margin="0,0,0,12">

                    <Button Content="Denak"
                            Tag="Denak"
                            Style="{StaticResource KategoriaBotoia}"
                            Background="#168653"
                            Click="Kategoria_Click"/>

                    <Button Content="Edariak"
                            Tag="Edariak"
                            Style="{StaticResource KategoriaBotoia}"
                            Click="Kategoria_Click"/>

                    <Button Content="Kafeak"
                            Tag="Kafeak"
                            Style="{StaticResource KategoriaBotoia}"
                            Click="Kategoria_Click"/>

                    <Button Content="Janaria"
                            Tag="Janaria"
                            Style="{StaticResource KategoriaBotoia}"
                            Click="Kategoria_Click"/>

                </WrapPanel>

                <!-- Produktuak agertzen dira hemen -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">

                    <WrapPanel x:Name="panelProduktuak"
                               Orientation="Horizontal"/>

                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Eskuineko aldea: kontsumoa -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="KONTSUMOA"
                           FontSize="21"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <!-- Aukeratutako produktuak -->
                <DataGrid x:Name="dgvKontsumoa"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          BorderThickness="0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Produktua"
                                            Binding="{Binding Produktua}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Kop."
                                            Binding="{Binding Kantitatea}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Prezioa"
                                            Binding="{Binding Prezioa, StringFormat={}{0:F2} €}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Guztira"
                                            Binding="{Binding Guztira, StringFormat={}{0:F2} €}"
                                            Width="85"/>

                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2"
                        Content="Aukeratutako produktua kendu"
                        Background="#E8EDF1"
                        Style="{StaticResource EkintzaBotoia}"
                        Margin="0,12,0,15"
                        Click="BtnKendu_Click"/>

                <!-- Guztizko prezioa eta ekintzak -->
                <StackPanel Grid.Row="3">

                    <Separator Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,18">

                        <TextBlock Text="GUZTIRA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtGuztira"
                                   Text="0,00 €"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#168653"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <Button Content="KONTSUMOA AMAITU"
                            Background="#168653"
                            Foreground="White"
                            Style="{StaticResource EkintzaBotoia}"
                            Margin="0,0,0,9"
                            Height="48"
                            Click="BtnAmaitu_Click"/>

                    <Button Content="KONTSUMOA EZEZTATU"
                            Background="#F0E5E5"
                            Foreground="#8B3333"
                            Style="{StaticResource EkintzaBotoia}"
                            Height="42"
                            Click="BtnEzeztatu_Click"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
