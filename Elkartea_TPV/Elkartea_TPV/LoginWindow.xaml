<Window
    x:Class="Elkartea_TPV.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Elkartea TPV"
    Width="750"
    Height="450"
    Background="#F2F2F2"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Border
            Width="350"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12">

            <StackPanel>

                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="27"
                    FontWeight="Bold"
                    Foreground="#34495E"
                    Text="ELKARTEA TPV" />

                <TextBlock
                    Margin="0,0,0,25"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="Gray"
                    Text="Elkarte gastronomikoa" />

                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="SemiBold"
                    Text="Erabiltzailea" />

                <TextBox
                    x:Name="txtErabiltzailea"
                    Height="35"
                    Margin="0,0,0,15"
                    Padding="8" />

                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="SemiBold"
                    Text="Pasahitza" />

                <PasswordBox
                    x:Name="txtPasahitza"
                    Height="35"
                    Margin="0,0,0,20"
                    Padding="8" />

                <Button
                    Height="40"
                    Background="#34495E"
                    BorderThickness="0"
                    Click="BtnLogin_Click"
                    Content="Saioa hasi"
                    FontWeight="Bold"
                    Foreground="White" />

                <TextBlock
                    x:Name="txtMezua"
                    Margin="0,15,0,0"
                    Foreground="Red"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

            </StackPanel>
        </Border>
    </Grid>
</Window>
