<Window x:Class="Elkartea_TPV.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elkartea TPV"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F2F2">

    <Grid>
        <Border Width="350"
                Padding="30"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="ELKARTEA TPV"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#34495E"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Elkarte gastronomikoa"
                           FontSize="15"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Erabiltzailea"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtErabiltzailea"
                         Height="35"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Pasahitza"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="txtPasahitza"
                             Height="35"
                             Padding="8"
                             Margin="0,0,0,20"/>

                <Button Content="Saioa hasi"
                        Height="40"
                        Background="#34495E"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="BtnLogin_Click"/>

                <TextBlock x:Name="txtMezua"
                           Foreground="Red"
                           TextAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
